# Servidor web (IP e porta em que o site vai rodar)
APP_HOST=0.0.0.0
APP_PORT=5000
APP_ENV=dev

# Cache SQL em memoria, por processo (0 desliga)
CACHE_SEGUNDOS=300
CACHE_MAX_ENTRADAS=64

# Banco de dados (SQL Server com autenticacao Windows)
DB_SERVER=DESKTOP-G4V6794
DB_DRIVER=ODBC Driver 17 for SQL Server
